{
    "compilerOptions": {
        "module": "node20",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2022",
        "strict": false,
        "noImplicitAny": true,
        "types": ["node"],
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ]
}
